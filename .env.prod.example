# Copie para .env.prod NO SERVIDOR e preencha. Nunca faça commit do .env.prod.

# URL do PostgreSQL gerenciado (o provedor mostra no painel). Use sslmode=require.
FINANCEIRO_DB_URL=postgresql+psycopg://usuario:senha@host:5432/banco?sslmode=require

# Chave que o bot (e o painel) mandam para a API. Gere uma aleatória com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FINANCEIRO_API_KEY=

# Token do bot de produção (@BotFather). Use um bot diferente do de testes.
TELEGRAM_TOKEN=

# Assina os links e cookies do painel web. Gere como a FINANCEIRO_API_KEY.
FINANCEIRO_SEGREDO=

# Endereço público do painel, com HTTPS (ex.: https://painel.seudominio.com.br).
FINANCEIRO_PAINEL_URL=

# Seu id numérico no Telegram (o @userinfobot mostra). Só ele pode usar /stats.
ADMIN_TELEGRAM_ID=
