# Copie para .env e troque os valores. O .env nunca vai para o git.
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=financeiro

# Token do bot, gerado pelo @BotFather no Telegram. Nunca coloque no código.
TELEGRAM_TOKEN=

# Opcional no desenvolvimento: com ela, a API exige o cabeçalho X-API-Key.
FINANCEIRO_API_KEY=

# Seu id numérico no Telegram (o @userinfobot mostra). Só ele pode usar /stats.
ADMIN_TELEGRAM_ID=
